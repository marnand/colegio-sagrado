# Public Web3Forms variables injected at build time.
# Values become part of the static HTML output — they are NOT secrets.
# Configure the same names as GitHub Actions repository variables/secrets
# (PUBLIC_WEB3FORMS_REDIRECT and PUBLIC_WEB3FORMS_SUBJECT) and as a repository
# secret (PUBLIC_WEB3FORMS_ACCESS_KEY) so the build can read them.
PUBLIC_WEB3FORMS_ACCESS_KEY=
PUBLIC_WEB3FORMS_REDIRECT=https://colegiosagrado.com.br/obrigado/
PUBLIC_WEB3FORMS_SUBJECT=Novo contato via site do Colégio Sagrado