---
const pillars = [
  {
    label: "Missão",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: "Nossa Missão",
    text: "Formar alunos com valores, disciplina, responsabilidade e propósito. Desenvolvemos cada criança e adolescente de forma integral, respeitando suas individualidades e potencializando suas capacidades — porque mais do que ensinar, formamos vidas.",
  },
  {
    label: "Visão",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/></svg>`,
    title: "Nossa Visão",
    text: "Ser referência em educação humanista e de excelência em nossa comunidade, promovendo o desenvolvimento integral de cada aluno, que se reconhece como protagonista de sua história e se prepara para a vida com ética, empatia e competência.",
  },
  {
    label: "Valores",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    title: "Nossos Valores",
    text: "Fé, amor, respeito, responsabilidade e excelência. Acreditamos que família e escola caminham juntas, construindo um ambiente de confiança, acolhimento e crescimento — porque educar é, acima de tudo, caminhar juntos.",
  },
];
---

<section class="py-24 bg-[#FAF8F5] relative overflow-hidden">
  <!-- Subtle decorative cross watermark -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-96 h-96 opacity-[0.03] pointer-events-none select-none" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="42" y="5" width="16" height="90" rx="4" fill="#9c0d12"/>
      <rect x="5" y="38" width="90" height="16" rx="4" fill="#9c0d12"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Eyebrow + heading -->
    <div class="text-center mb-16">
      <span class="text-primary font-semibold tracking-wider text-sm uppercase mb-3 block">
        Identidade Institucional
      </span>
      <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl font-bold text-foreground leading-tight">
        QUEM SOMOS E <span class="text-primary">O QUE NOS MOVE</span>
      </h2>
    </div>

    <!-- Three pillars grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pillars.map((pillar, i) => (
        <div class={`relative bg-white rounded-2xl p-10 shadow-sm hover:shadow-xl transition-all duration-300 group border border-transparent hover:border-primary/20 ${i === 1 ? 'md:mt-6' : ''}`}>
          <!-- Red top accent bar -->
          <div class="absolute top-0 left-8 right-8 h-1 bg-primary rounded-b-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <!-- Icon in gold circle -->
          <div class="w-16 h-16 rounded-full bg-secondary/15 flex items-center justify-center text-primary mb-6 group-hover:bg-primary group-hover:text-white transition-all duration-300">
            <Fragment set:html={pillar.icon} />
          </div>

          <!-- Label pill -->
          <span class="inline-block py-0.5 px-3 bg-primary/8 text-primary border border-primary/20 rounded-full text-xs font-semibold uppercase tracking-widest mb-4">
            {pillar.label}
          </span>

          <h3 class="font-['Playfair_Display'] text-2xl font-bold text-foreground mb-4">
            {pillar.title}
          </h3>

          <p class="text-gray-600 leading-relaxed text-base">
            {pillar.text}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
