---
import { Shield, Eye, Heart, Cross, Lightbulb, Handshake, Award } from 'lucide-react';

const pillars = [
  {
    label: 'Missão',
    icon: Shield,
    title: 'Nossa Missão',
    text: 'Promover uma educação de excelência, fundamentada em valores cristãos, contribuindo para a formação integral de cidadãos éticos, responsáveis, solidários e preparados para os desafios da vida.',
  },
  {
    label: 'Visão',
    icon: Eye,
    title: 'Nossa Visão',
    text: 'Com mais de 25 anos de tradição, ser referência em educação pela qualidade do ensino, pela formação humana e pelo compromisso com o desenvolvimento de cada estudante.',
  },
];

const values = [
  { label: 'Fé Cristã', icon: Cross },
  { label: 'Respeito', icon: Heart },
  { label: 'Conhecimento', icon: Lightbulb },
  { label: 'Responsabilidade', icon: Handshake },
  { label: 'Excelência', icon: Award },
];
---

<section class="py-24 bg-[#FAF8F5] relative overflow-hidden">
  <!-- Subtle decorative cross watermark -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-96 h-96 opacity-[0.03] pointer-events-none select-none" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="42" y="5" width="16" height="90" rx="4" fill="#9c0d12"/>
      <rect x="5" y="38" width="90" height="16" rx="4" fill="#9c0d12"/>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Eyebrow + heading -->
    <div class="text-center mb-16">
      <h2 class="font-serif text-4xl md:text-5xl font-bold text-foreground leading-tight">
        Nossa essência
      </h2>
    </div>

    <!-- Missão + Visão grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {pillars.map((pillar) => {
        const Icon = pillar.icon;
        return (
          <div class="relative bg-white rounded-2xl p-10 shadow-sm hover:shadow-xl transition-all duration-300 group border border-transparent hover:border-primary/20">
            <!-- Red top accent bar -->
            <div class="absolute top-0 left-8 right-8 h-1 bg-primary rounded-b-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <!-- Icon in gold circle -->
            <div class="w-16 h-16 rounded-full bg-secondary/15 flex items-center justify-center text-primary mb-6 group-hover:bg-primary group-hover:text-white transition-all duration-300">
              <Icon size={28} />
            </div>

            <!-- Label pill -->
            <span class="inline-block py-0.5 px-3 bg-primary/8 text-primary border border-primary/20 rounded-full text-xs font-semibold uppercase tracking-widest mb-4">
              {pillar.label}
            </span>

            <h3 class="font-serif text-2xl font-bold text-foreground mb-4">
              {pillar.title}
            </h3>

            <p class="text-gray-600 leading-relaxed text-base">
              {pillar.text}
            </p>
          </div>
        );
      })}
    </div>

    <!-- Valores -->
    <div class="text-center mb-10">
      <span class="inline-block py-0.5 px-3 bg-primary/8 text-primary border border-primary/20 rounded-full text-xs font-semibold uppercase tracking-widest mb-4">
        Valores
      </span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      {values.map((value) => {
        const Icon = value.icon;
        return (
          <div class="group relative bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-transparent hover:border-primary/20 text-center">
            <div class="w-12 h-12 rounded-full bg-secondary/15 flex items-center justify-center text-primary mx-auto mb-4 group-hover:bg-primary group-hover:text-white transition-all duration-300">
              <Icon size={24} />
            </div>
            <h4 class="font-serif text-lg font-bold text-foreground">
              {value.label}
            </h4>
          </div>
        );
      })}
    </div>
  </div>
</section>
