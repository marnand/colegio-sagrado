---
import { CalendarDays, ChevronRight } from 'lucide-react';

const dayLabels = ['D', 'S', 'T', 'Q', 'Q', 'S', 'S'];
// April 2026 starts on Wednesday (offset = 3)
const startOffset = 3;
const totalDays = 30;
const eventDays = [10, 15, 22];
const todayDay = 4;

const days = Array.from({ length: totalDays }, (_, i) => i + 1);

const events = [
  { date: "10 Abril", title: "Feira de Ciências e Tecnologia", desc: "Apresentação dos projetos de robótica e sustentabilidade do Fundamental II.", color: "bg-blue-500" },
  { date: "15 Abril", title: "Reunião de Pais e Mestres", desc: "Entrega de boletins e acompanhamento pedagógico bimestral.", color: "bg-primary" },
  { date: "22 Abril", title: "Jogos da Primavera Sagrado", desc: "Início das olimpíadas esportivas internas com todas as turmas.", color: "bg-secondary" },
];
---
<section id="academico" class="py-24 bg-surface-warm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12">
      <div>
        <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl font-bold text-foreground">
          CALENDÁRIO ACADÊMICO
        </h2>
      </div>
      <a href="#" class="hidden md:flex items-center text-primary font-semibold hover:underline mt-4 md:mt-0 cursor-pointer">
        Ver calendário completo <ChevronRight size={18} />
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
      <!-- Calendar Visual -->
      <div class="lg:col-span-2 p-8 bg-gray-50 border-r border-gray-100">
        <div class="flex justify-between items-center mb-6">
          <h3 class="font-bold text-xl text-gray-800">Abril 2026</h3>
          <div class="flex gap-2">
            <button aria-label="Mês anterior" class="w-11 h-11 rounded bg-white shadow flex items-center justify-center text-gray-500 hover:text-primary cursor-pointer">&lt;</button>
            <button aria-label="Próximo mês" class="w-11 h-11 rounded bg-white shadow flex items-center justify-center text-gray-500 hover:text-primary cursor-pointer">&gt;</button>
          </div>
        </div>

        <div class="grid grid-cols-7 gap-2 text-center text-sm mb-4">
          {dayLabels.map((d, idx) => (
            <div class="font-semibold text-gray-400">{d}</div>
          ))}
        </div>

        <div class="grid grid-cols-7 gap-2 text-center">
          <!-- Start offset for April 2026 (starts on Wednesday = index 3) -->
          {Array.from({ length: startOffset }, (_, i) => (
            <div class="p-2"></div>
          ))}
          {days.map((day) => {
            const isEvent = eventDays.includes(day);
            const isToday = day === todayDay;
            return (
              <div
                class={`p-2 rounded-full w-10 h-10 mx-auto flex items-center justify-center font-medium transition-all cursor-pointer
                  ${isToday ? "bg-primary text-white shadow-md" :
                    isEvent ? "bg-primary/5 text-primary border border-primary/10" :
                    "text-gray-600 hover:bg-gray-200"
                  }`}
              >
                {day}
              </div>
            );
          })}
        </div>
      </div>

      <!-- Events List -->
      <div class="lg:col-span-3 p-8">
        <h3 class="font-bold text-xl text-gray-800 mb-6 flex items-center">
          <CalendarDays className="mr-2 text-primary" size={24} />
          Próximos Eventos
        </h3>

        <div class="space-y-6">
          {events.map((event) => {
            const [day, month] = event.date.split(' ');
            return (
              <div class="flex gap-6 group cursor-pointer">
                <div class="flex flex-col items-center min-w-20">
                  <span class="text-xs font-bold text-gray-400 uppercase">{month}</span>
                  <span class="text-2xl font-black text-gray-800 group-hover:text-primary transition-colors">{day}</span>
                </div>
                <div class={`w-2 h-2 rounded-full ${event.color} mt-3 shrink-0`}></div>
                <div>
                  <h4 class="font-bold text-lg text-gray-800 group-hover:text-primary transition-colors">{event.title}</h4>
                  <p class="text-gray-500 text-sm mt-1 leading-relaxed">{event.desc}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
