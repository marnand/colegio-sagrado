---
import {
  BookOpen,
  Heart,
  Users,
  Brain,
  Cpu,
  UserCheck,
  Shield,
} from "lucide-react";

const cards = [
  {
    title: "Sistema Positivo de Ensino",
    description: "Metodologia que valoriza o que o aluno sabe.",
    icon: BookOpen,
    position: "top-[4%] left-[2%]",
  },
  {
    title: "Educação baseada em valores cristãos",
    description: "Formação integral com fé e respeito.",
    icon: Heart,
    position: "top-[-12%] right-[4%]",
  },
  {
    title: "Parceria Escola e Família",
    description: "Caminhamos juntos na educação dos filhos.",
    icon: Users,
    position: "top-[37%] left-[-2%]",
  },
  {
    title: "Desenvolvimento socioemocional",
    description: "Inteligência emocional desde a infância.",
    icon: Brain,
    position: "top-[28%] right-[2%]",
  },
  {
    title: "Inovação e tecnologia",
    description: "Robótica, maker e recursos digitais.",
    icon: Cpu,
    position: "bottom-[4%] left-[6%]",
  },
  {
    title: "Equipe comprometida",
    description: "Professores dedicados e em constante evolução.",
    icon: UserCheck,
    position: "bottom-[20%] right-[10%]",
  },
  {
    title: "Ambiente seguro e acolhedor",
    description: "Estrutura pensada para o bem-estar.",
    icon: Shield,
    position: "top-[94%] left-[58%] -translate-x-1/2",
  },
];
---

<section id="diferenciais" class="relative py-24 bg-[#f8f9fa]">
  <!-- Subtle dot grid texture -->
  <div class="absolute inset-0 dot-pattern opacity-40 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12 lg:mb-16">
      <span class="text-primary font-semibold tracking-[0.2em] text-sm uppercase block mb-4">
        Nossos Diferenciais
      </span>
      <h2 class="font-serif text-4xl md:text-5xl font-bold text-foreground mb-5">
        Por que escolher o Colégio <span class="text-primary">Sagrado</span>?
      </h2>
      <p class="text-lg text-muted-foreground max-w-3xl mx-auto leading-relaxed">
        Nossa proposta educacional une tradição, inovação e formação humana para
        preparar alunos capazes de aprender, conviver e transformar o mundo ao
        seu redor.
      </p>
    </div>

    <!-- Mobile Layout -->
    <div class="lg:hidden">
      <div class="flex justify-center mb-10">
        <div class="relative w-64 h-64 sm:w-72 sm:h-72 rounded-[2.5rem] flex items-center justify-center">
          <img
            src="/mascote.svg"
            alt="Sagradinho, mascote do Colégio Sagrado"
            class="w-68 h-68 sm:w-68 sm:h-68 object-contain drop-shadow-xl float-soft"
            loading="lazy"
          />
        </div>
      </div>
      <div class="space-y-3 max-w-md mx-auto">
        {
          cards.map((card) => {
            const Icon = card.icon;
            return (
              <div class="group flex items-center gap-3 bg-white rounded-2xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0 group-hover:bg-primary group-hover:text-white transition-all duration-300">
                  <Icon size={20} />
                </div>
                <div class="min-w-0">
                  <h3 class="font-serif text-sm font-bold text-foreground leading-tight">
                    {card.title}
                  </h3>
                  <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">{card.description}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Desktop Layout: Stage + floating cards -->
    <div class="hidden lg:block relative h-112.5 w-full mx-auto">
      <!-- Mascote -->
      <div class="absolute top-64 left-1/2 z-20 float-mascote" style="transform: translate(-50%, -50%);">
        <div class="relative w-170 h-170">
          <img
            src="/mascote.svg"
            alt="Sagradinho, mascote do Colégio Sagrado"
            class="w-full h-full object-contain drop-shadow-2xl"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Floating Cards -->
      {
        cards.map((card) => {
          const Icon = card.icon;
          return (
            <div class={`absolute z-20 w-[288px] ${card.position}`}>
              <div class="group bg-white rounded-2xl p-4 border border-gray-100 shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 cursor-default">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary shrink-0 group-hover:bg-primary group-hover:text-white transition-all duration-300">
                    <Icon size={20} />
                  </div>
                  <div class="min-w-0">
                    <h3 class="font-serif text-sm font-bold text-foreground leading-tight">
                      {card.title}
                    </h3>
                    <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">
                      {card.description}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .dot-pattern {
    background-image: radial-gradient(circle, rgba(26, 26, 26, 0.04) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  @keyframes float-soft {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes float-mascote {
    0%, 100% {
      transform: translate(-50%, -50%) translateY(0px);
    }
    50% {
      transform: translate(-50%, -50%) translateY(-8px);
    }
  }

  .float-soft {
    animation: float-soft 6s ease-in-out infinite;
  }

  .float-mascote {
    animation: float-mascote 8s ease-in-out infinite;
  }
</style>
