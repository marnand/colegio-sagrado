---
import { BookOpen, Cpu, BookMarked, Shield, Compass, ChevronRight } from 'lucide-react';

const featured = {
  title: "Infraestrutura de Excelência",
  desc: "Ambientes modernos, laboratórios equipados e amplas áreas verdes para desenvolvimento integral.",
  img: "https://images.unsplash.com/photo-1562774053-701939374585?w=800&q=80",
  imgAlt: "Corredor moderno de escola com amplos espaços e iluminação natural",
  href: "#sobre-nos",
};

const smallCards = [
  {
    title: "Cultura Maker e Robótica",
    img: "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=600&q=80",
    imgAlt: "Aluno montando robô em atividade de robótica educacional",
    icon: "Cpu",
    href: "#academico",
    items: [
      "Projetos práticos de robótica e cultura maker",
      "Desenvolve criatividade e raciocínio lógico",
    ],
  },
  {
    title: "Leitura e Acompanhamento Pedagógico",
    img: "https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=600&q=80",
    imgAlt: "Alunos lendo em biblioteca escolar acolhedora",
    icon: "BookMarked",
    href: "#academico",
    items: [
      "Projeto de Leitura que desenvolve pensamento e expressão",
      "Acompanhamento pedagógico próximo e individualizado",
    ],
  },
  {
    title: "Valores e Ambiente Acolhedor",
    img: "https://images.unsplash.com/photo-1529390079861-591de354faf5?w=600&q=80",
    imgAlt: "Crianças em atividade colaborativa em ambiente escolar seguro",
    icon: "Shield",
    href: "#sobre-nos",
    items: [
      "Projetos que fortalecem valores e responsabilidade",
      "Ambiente seguro, organizado e acolhedor",
    ],
  },
  {
    title: "Formação Humana com Propósito",
    img: "https://images.unsplash.com/photo-1509062522246-3755977927d7?w=600&q=80",
    imgAlt: "Estudantes em momento de reflexão e aprendizado em sala de aula",
    icon: "Compass",
    href: "#sobre-nos",
    items: [
      "Educação com propósito e formação humana",
      "Desenvolvimento integral do aluno como protagonista",
    ],
  },
];
---
<section class="py-24 bg-surface-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16">
      <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl font-bold mb-4">
        NOSSO DIFERENCIAL<br/><span class="text-secondary">EDUCATIVO</span>
      </h2>
      <div class="w-16 h-1 bg-primary rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

      <!-- Featured card — 2 cols, full height -->
      <div class="lg:col-span-2 group relative overflow-hidden rounded-xl border border-gray-800 hover:border-primary transition-colors duration-300 min-h-105">
        <img
          src={featured.img}
          alt={featured.imgAlt}
          loading="lazy"
          width="800"
          height="420"
          class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-70 group-hover:scale-105 transition-all duration-700"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent"></div>
        <div aria-hidden="true" class="absolute top-6 left-6 p-3 bg-primary/80 rounded-full text-white">
          <BookOpen size={28} />
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-8">
          <h3 class="font-['Playfair_Display'] text-2xl font-bold mb-3">{featured.title}</h3>
          <p class="text-white/70 text-sm leading-relaxed mb-4">{featured.desc}</p>
          <a href={featured.href} class="text-secondary text-sm font-semibold flex items-center hover:text-white transition-colors cursor-pointer">
            Explorar <ChevronRight size={16} className="ml-1" />
          </a>
        </div>
      </div>

      <!-- Right column — 3 cols: 4 horizontal image+text cards stacked -->
      <div class="lg:col-span-3 flex flex-col gap-4">
        {smallCards.map((card) => (
          <div class="group relative overflow-hidden rounded-xl bg-gray-900 border border-gray-800 hover:border-primary transition-colors duration-300 flex flex-col sm:flex-row">
            <div class="w-full sm:w-36 h-36 sm:h-auto shrink-0 overflow-hidden">
              <img
                src={card.img}
                alt={card.imgAlt}
                loading="lazy"
                width="600"
                height="144"
                class="w-full h-full object-cover opacity-60 group-hover:opacity-90 group-hover:scale-105 transition-all duration-500"
              />
            </div>
            <div class="p-5 flex flex-col justify-center">
              <div aria-hidden="true" class="text-secondary mb-2">
                {card.icon === "Cpu"        && <Cpu        size={20} />}
                {card.icon === "BookMarked" && <BookMarked size={20} />}
                {card.icon === "Shield"     && <Shield     size={20} />}
                {card.icon === "Compass"    && <Compass    size={20} />}
              </div>
              <h3 class="font-['Playfair_Display'] text-base font-bold mb-2">{card.title}</h3>
              <ul class="space-y-1 mb-3">
                {card.items.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-secondary font-bold text-xs leading-none mt-0.75 shrink-0" aria-hidden="true">✔</span>
                    <span class="text-gray-400 text-xs leading-snug">{item}</span>
                  </li>
                ))}
              </ul>
              <a href={card.href} class="text-secondary text-xs font-semibold flex items-center group-hover:text-white transition-colors cursor-pointer">
                Explorar <ChevronRight size={13} className="ml-1" />
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
