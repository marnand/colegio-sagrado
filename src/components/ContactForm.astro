---
const contactItems = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
    label: "Endereço",
    value: "Rua 02 qd 36 nº 51 Cohatrac II, São Luis - MA",
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-2 .9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
    label: "E-mail",
    value: "colegio.cscj@gmail.com",
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
    label: "Horário de atendimento",
    value: "Segunda a Sexta, 8h às 17h",
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.56 3.37 2 2 0 0 1 3.54 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8a16 16 0 0 0 6 6l.72-.72a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
    label: "Recepção / CSCJ",
    value: "(98) 98703-1316",
  },
];

const segments = [
  "Educação Infantil (2–5 anos)",
  "Ensino Fundamental I (6–10 anos)",
  "Ensino Fundamental II (11–14 anos)",
  "Ainda não sei",
];

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const successRedirect =
  import.meta.env.PUBLIC_WEB3FORMS_REDIRECT ?? "/obrigado/";
const subjectLine =
  import.meta.env.PUBLIC_WEB3FORMS_SUBJECT ?? "Novo contato via site do Colégio Sagrado";
---

<section id="contato" class="py-24 bg-[#FAF8F5] relative overflow-hidden">
  <div
    class="absolute top-0 left-0 right-0 h-1 bg-linear-to-r from-transparent via-primary to-transparent opacity-20"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span
        class="text-primary font-semibold tracking-wider text-sm uppercase mb-3 block"
        >Entre em Contato</span
      >
      <h2
        class="font-serif text-4xl md:text-5xl font-bold text-foreground leading-tight mb-4"
      >
        VISITE NOSSA <span class="text-primary">ESCOLA</span>
      </h2>
      <p
        class="text-gray-600 text-lg max-w-2xl mx-auto leading-relaxed font-light"
      >
        Seu filho merece mais do que você pode ver em um site. Venha conhecer de
        perto o Colégio Sagrado e sentir a segurança, o cuidado e a excelência
        do nosso trabalho.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">
      <div
        class="lg:col-span-3 bg-white rounded-2xl shadow-xl p-8 md:p-10 border border-gray-100"
      >
        <h3 class="font-serif text-2xl font-bold text-foreground mb-8">
          Solicite contato ou agende uma visita
        </h3>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          aria-label="Formulário de contato do Colégio Sagrado"
          class="space-y-5"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="subject" value={subjectLine} />
          <input type="hidden" name="from_name" value="Site Colégio Sagrado" />
          <input type="hidden" name="redirect" value={successRedirect} />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display: none;"
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label
                for="cf-name"
                class="block text-sm font-semibold text-gray-700 mb-1.5"
              >
                Nome completo <span class="text-primary" aria-hidden="true"
                  >*</span
                >
              </label>
              <input
                id="cf-name"
                name="name"
                type="text"
                required
                minlength="2"
                maxlength="200"
                autocomplete="name"
                placeholder="Seu nome completo"
                class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
              />
            </div>
            <div>
              <label
                for="cf-phone"
                class="block text-sm font-semibold text-gray-700 mb-1.5"
              >
                Telefone / WhatsApp <span
                  class="text-primary"
                  aria-hidden="true">*</span
                >
              </label>
              <input
                id="cf-phone"
                name="phone"
                type="tel"
                required
                minlength="10"
                maxlength="20"
                pattern="[0-9 ()+\-]{10,20}"
                inputmode="tel"
                autocomplete="tel"
                placeholder="(98) 9 0000-0000"
                class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
              />
            </div>
          </div>

          <div>
            <label
              for="cf-email"
              class="block text-sm font-semibold text-gray-700 mb-1.5"
            >
              E-mail
            </label>
            <input
              id="cf-email"
              name="email"
              type="email"
              maxlength="320"
              autocomplete="email"
              placeholder="seu@email.com"
              class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
            />
          </div>

          <div>
            <label
              for="cf-segment"
              class="block text-sm font-semibold text-gray-700 mb-1.5"
            >
              Segmento de interesse <span
                class="text-primary"
                aria-hidden="true">*</span
              >
            </label>
            <select
              id="cf-segment"
              name="segment"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors bg-white appearance-none"
            >
              <option value="" disabled selected>Selecione um segmento</option>
              {segments.map((seg) => <option value={seg}>{seg}</option>)}
            </select>
          </div>

          <fieldset class="border border-gray-200 rounded-lg p-4">
            <legend class="px-2 text-sm font-semibold text-gray-700">
              Preferência de visita (opcional)
            </legend>
            <p class="text-xs text-gray-500 mb-4">
              A data e o horário abaixo são uma preferência. A escola confirmará
              o agendamento pelo telefone ou WhatsApp informados.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label
                  for="cf-visit-date"
                  class="block text-sm font-semibold text-gray-700 mb-1.5"
                >
                  Data desejada
                </label>
                <input
                  id="cf-visit-date"
                  name="visit_date"
                  type="date"
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                />
              </div>
              <div>
                <label
                  for="cf-visit-time"
                  class="block text-sm font-semibold text-gray-700 mb-1.5"
                >
                  Horário preferido
                </label>
                <input
                  id="cf-visit-time"
                  name="visit_time"
                  type="time"
                  min="08:00"
                  max="17:00"
                  step="1800"
                  class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                />
              </div>
            </div>
          </fieldset>

          <div>
            <label
              for="cf-message"
              class="block text-sm font-semibold text-gray-700 mb-1.5"
            >
              Mensagem (opcional)
            </label>
            <textarea
              id="cf-message"
              name="message"
              rows="4"
              maxlength="2000"
              placeholder="Dúvidas sobre matrículas, horários ou visitas?"
              class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors resize-none"
            ></textarea>
          </div>

          <div class="h-captcha" data-captcha="true"></div>

          <button
            type="submit"
            class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-4 px-8 rounded-full shadow-lg shadow-primary/25 transition-all hover:scale-[1.02] tracking-wider uppercase text-sm cursor-pointer"
          >
            Enviar Mensagem
          </button>

          <p class="text-xs text-gray-400 text-center">
            Ao enviar, você concorda com o tratamento dos dados pela escola e
            pelo serviço de formulário{" "}
            <a
              href="/privacidade/"
              class="underline hover:text-primary transition-colors cursor-pointer"
              >Política de Privacidade</a
            >.
          </p>
        </form>
      </div>

      <div class="lg:col-span-2 flex flex-col gap-5">
        <div class="bg-primary rounded-2xl p-8 text-white">
          <h3 class="font-serif text-xl font-bold mb-6">
            Informações de Contato
          </h3>

          <ul class="space-y-5" role="list">
            {
              contactItems.map((item) => (
                <li class="flex items-start gap-4">
                  <span class="mt-0.5 w-9 h-9 rounded-full bg-white/15 flex items-center justify-center shrink-0 text-secondary">
                    <Fragment set:html={item.icon} />
                  </span>
                  <div>
                    <p class="text-white/60 text-xs uppercase tracking-wider font-semibold mb-0.5">
                      {item.label}
                    </p>
                    <p class="text-white font-medium text-sm">{item.value}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="w-full h-full min-h-80 rounded-2xl overflow-hidden shadow-xl border border-gray-100">
          <iframe
            src="https://www.google.com/maps?q=Rua+02+qd+36+51+Cohatrac+II+Sao+Luis+MA&output=embed"
            width="100%"
            height="100%"
            style="border:0; min-height:320px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa do Colégio Sagrado Coração de Jesus"
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <script src="https://web3forms.com/client/script.js" async defer></script>
</section>