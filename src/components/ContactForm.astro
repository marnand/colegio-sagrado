---
const contactItems = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
    label: "Endereço",
    value: "Rua 02 qd 36 nº 51 Cohatrac II, São Luis - MA",
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
    label: "E-mail",
    value: "colegio.cscj@gmail.com",
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
    label: "Horário de atendimento",
    value: "Segunda a Sexta, 8h às 17h",
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.56 3.37 2 2 0 0 1 3.54 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8a16 16 0 0 0 6 6l.72-.72a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
    label: "Recepção / CSCJ",
    value: "(98) 98703-1316",
  },
];

const segments = [
  "Educação Infantil (2–5 anos)",
  "Ensino Fundamental I (6–10 anos)",
  "Ensino Fundamental II (11–14 anos)",
  "Ainda não sei",
];
---

<section id="contato" class="py-24 bg-[#FAF8F5] relative overflow-hidden">
  <!-- Background accent -->
  <div
    class="absolute top-0 left-0 right-0 h-1 bg-linear-to-r from-transparent via-primary to-transparent opacity-20"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-16">
      <span
        class="text-primary font-semibold tracking-wider text-sm uppercase mb-3 block"
        >Entre em Contato</span
      >
      <h2
        class="font-serif text-4xl md:text-5xl font-bold text-foreground leading-tight mb-4"
      >
        VISITE NOSSA <span class="text-primary">ESCOLA</span>
      </h2>
      <p
        class="text-gray-600 text-lg max-w-2xl mx-auto leading-relaxed font-light"
      >
        Seu filho merece mais do que você pode ver em um site. Venha conhecer de
        perto o Colégio Sagrado e sentir a segurança, o cuidado e a excelência
        do nosso trabalho.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">
      <!-- Form card — 3 cols -->
      <div
        class="lg:col-span-3 bg-white rounded-2xl shadow-xl p-8 md:p-10 border border-gray-100"
      >
        <h3 class="font-serif text-2xl font-bold text-foreground mb-8">
          Agende uma visita
        </h3>

        <form
          aria-label="Formulário de agendamento de visita"
          class="space-y-5"
          novalidate
        >
          <!-- Name + Phone row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label
                for="cf-name"
                class="block text-sm font-semibold text-gray-700 mb-1.5"
              >
                Nome completo <span class="text-primary" aria-hidden="true"
                  >*</span
                >
              </label>
              <input
                id="cf-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Seu nome completo"
                class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
              />
            </div>
            <div>
              <label
                for="cf-phone"
                class="block text-sm font-semibold text-gray-700 mb-1.5"
              >
                Telefone / WhatsApp <span
                  class="text-primary"
                  aria-hidden="true">*</span
                >
              </label>
              <input
                id="cf-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="(98) 9 0000-0000"
                class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
              />
            </div>
          </div>

          <!-- Email -->
          <div>
            <label
              for="cf-email"
              class="block text-sm font-semibold text-gray-700 mb-1.5"
            >
              E-mail
            </label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="seu@email.com"
              class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
            />
          </div>

          <!-- Segment select -->
          <div>
            <label
              for="cf-segment"
              class="block text-sm font-semibold text-gray-700 mb-1.5"
            >
              Segmento de interesse <span
                class="text-primary"
                aria-hidden="true">*</span
              >
            </label>
            <select
              id="cf-segment"
              name="segment"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors bg-white appearance-none"
            >
              <option value="" disabled selected>Selecione um segmento</option>
              {segments.map((seg) => <option value={seg}>{seg}</option>)}
            </select>
          </div>

          <!-- Message -->
          <div>
            <label
              for="cf-message"
              class="block text-sm font-semibold text-gray-700 mb-1.5"
            >
              Mensagem (opcional)
            </label>
            <textarea
              id="cf-message"
              name="message"
              rows="4"
              placeholder="Dúvidas sobre matrículas, horários ou visitas?"
              class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Honeypot -->
          <div class="sr-only" aria-hidden="true">
            <label for="cf-hp">Não preencha este campo</label>
            <input
              id="cf-hp"
              name="hp"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-4 px-8 rounded-full shadow-lg shadow-primary/25 transition-all hover:scale-[1.02] tracking-wider uppercase text-sm cursor-pointer"
          >
            Enviar Mensagem
          </button>

          <p class="text-xs text-gray-400 text-center">
            Ao enviar, você concorda com nossa{" "}
            <a
              href="#"
              class="underline hover:text-primary transition-colors cursor-pointer"
              >Política de Privacidade</a
            >.
          </p>
        </form>
      </div>

      <!-- Info + mascote column — 2 cols -->
      <div class="lg:col-span-2 flex flex-col gap-5">
        <!-- Contact info card -->
        <div class="bg-primary rounded-2xl p-8 text-white">
          <h3 class="font-serif text-xl font-bold mb-6">
            Informações de Contato
          </h3>

          <ul class="space-y-5" role="list">
            {
              contactItems.map((item) => (
                <li class="flex items-start gap-4">
                  <span class="mt-0.5 w-9 h-9 rounded-full bg-white/15 flex items-center justify-center shrink-0 text-secondary">
                    <Fragment set:html={item.icon} />
                  </span>
                  <div>
                    <p class="text-white/60 text-xs uppercase tracking-wider font-semibold mb-0.5">
                      {item.label}
                    </p>
                    <p class="text-white font-medium text-sm">{item.value}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Google Maps -->
        <div class="w-full h-full min-h-80 rounded-2xl overflow-hidden shadow-xl border border-gray-100">
          <iframe
            src="https://www.google.com/maps?q=Rua+02+qd+36+51+Cohatrac+II+Sao+Luis+MA&output=embed"
            width="100%"
            height="100%"
            style="border:0; min-height:320px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa do Colégio Sagrado Coração de Jesus"
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const form = document.querySelector(
        'form[aria-label="Formulário de agendamento de visita"]',
      );
      if (!form) return;

      const submitBtn = form.querySelector('button[type="submit"]');
      const successMsg = document.createElement("div");
      successMsg.className =
        "hidden mt-4 p-4 bg-green-50 border border-green-200 rounded-xl text-green-800 text-sm";
      successMsg.innerHTML =
        '<p class="font-semibold">Mensagem enviada com sucesso!</p><p>Entraremos em contato em breve.</p>';
      form.insertBefore(successMsg, submitBtn);

      const errorMsg = document.createElement("div");
      errorMsg.className =
        "hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-red-800 text-sm";
      errorMsg.innerHTML =
        '<p class="font-semibold">Não foi possível enviar.</p><p>Tente novamente mais tarde.</p>';
      form.insertBefore(errorMsg, submitBtn);

      const rateLimitMsg = document.createElement("div");
      rateLimitMsg.className =
        "hidden mt-4 p-4 bg-amber-50 border border-amber-200 rounded-xl text-amber-800 text-sm";
      rateLimitMsg.innerHTML =
        '<p class="font-semibold">Muitas tentativas.</p><p>Por favor, aguarde um pouco antes de enviar novamente.</p>';
      form.insertBefore(rateLimitMsg, submitBtn);

      function showError(input, message) {
        let error = input.parentNode.querySelector(".error-msg");
        if (!error) {
          error = document.createElement("p");
          error.className = "error-msg text-primary text-xs mt-1";
          input.parentNode.appendChild(error);
        }
        error.textContent = message;
        input.classList.add("border-primary");
      }

      function clearError(input) {
        const error = input.parentNode.querySelector(".error-msg");
        if (error) error.remove();
        input.classList.remove("border-primary");
      }

      function validatePhone(phone) {
        const digits = phone.replace(/\D/g, "");
        return digits.length >= 10 && digits.length <= 11;
      }

      form.addEventListener("submit", async function (e) {
        e.preventDefault();
        let hasError = false;

        const name = form.querySelector("#cf-name");
        const phone = form.querySelector("#cf-phone");
        const email = form.querySelector("#cf-email");
        const segment = form.querySelector("#cf-segment");
        const message = form.querySelector("#cf-message");
        const hp = form.querySelector("#cf-hp");

        clearError(name);
        clearError(phone);
        clearError(segment);
        if (email) clearError(email);

        successMsg.classList.add("hidden");
        errorMsg.classList.add("hidden");
        rateLimitMsg.classList.add("hidden");

        if (!name.value.trim()) {
          showError(name, "Por favor, informe seu nome completo.");
          hasError = true;
        }

        if (!phone.value.trim()) {
          showError(phone, "Por favor, informe seu telefone.");
          hasError = true;
        } else if (!validatePhone(phone.value)) {
          showError(phone, "Por favor, informe um telefone válido com DDD.");
          hasError = true;
        }

        if (!segment.value) {
          showError(segment, "Por favor, selecione um segmento de interesse.");
          hasError = true;
        }

        if (email && email.value.trim() && !email.value.includes("@")) {
          showError(email, "Por favor, informe um e-mail válido.");
          hasError = true;
        }

        if (hasError) {
          const firstError = form.querySelector(".error-msg");
          if (firstError)
            firstError.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Enviando...";
        submitBtn.classList.add("opacity-75", "cursor-not-allowed");

        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              nome: name.value.trim(),
              telefone: phone.value.trim(),
              email: email ? email.value.trim() : "",
              segmento: segment.value,
              mensagem: message ? message.value.trim() : "",
              _hp: hp ? hp.value : "",
            }),
          });

          const data = await res.json();

          submitBtn.disabled = false;
          submitBtn.textContent = "Enviar Mensagem";
          submitBtn.classList.remove("opacity-75", "cursor-not-allowed");

          if (res.ok) {
            successMsg.classList.remove("hidden");
            form.reset();
            successMsg.scrollIntoView({
              behavior: "smooth",
              block: "center",
            });
            return;
          }

          if (res.status === 400 && data.field) {
            const fieldMap = {
              nome: name,
              telefone: phone,
              email: email,
              segmento: segment,
            };
            const target = fieldMap[data.field];
            if (target) {
              showError(target, data.error);
              target.scrollIntoView({ behavior: "smooth", block: "center" });
            } else {
              errorMsg.querySelector("p:last-child").textContent =
                data.error || "Verifique os dados e tente novamente.";
              errorMsg.classList.remove("hidden");
              errorMsg.scrollIntoView({ behavior: "smooth", block: "center" });
            }
            return;
          }

          if (res.status === 429) {
            rateLimitMsg.classList.remove("hidden");
            rateLimitMsg.scrollIntoView({
              behavior: "smooth",
              block: "center",
            });
            return;
          }

          errorMsg.querySelector("p:last-child").textContent =
            data.error || "Tente novamente mais tarde.";
          errorMsg.classList.remove("hidden");
          errorMsg.scrollIntoView({ behavior: "smooth", block: "center" });
        } catch {
          submitBtn.disabled = false;
          submitBtn.textContent = "Enviar Mensagem";
          submitBtn.classList.remove("opacity-75", "cursor-not-allowed");
          errorMsg.querySelector("p:last-child").textContent =
            "Erro de conexão. Tente novamente.";
          errorMsg.classList.remove("hidden");
          errorMsg.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });
    })();
  </script>
</section>
