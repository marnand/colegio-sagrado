---
import mascote from '../assets/mascote.svg';

const contactItems = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    label: "Endereço",
    value: "Rua 02 qd 36 nº 51 Cohatrac II, São Luis - MA",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
    label: "E-mail",
    value: "colegio.cscj@gmail.com",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    label: "Horário de atendimento",
    value: "Segunda a Sexta, 8h às 17h",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.56 3.37 2 2 0 0 1 3.54 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8a16 16 0 0 0 6 6l.72-.72a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
    label: "Recepção / CSCJ",
    value: "(98) 98703-1316",
  },
];

const segments = [
  "Educação Infantil (2–5 anos)",
  "Ensino Fundamental I (6–10 anos)",
  "Ensino Fundamental II (11–14 anos)",
  "Ainda não sei",
];
---

<section id="contato" class="py-24 bg-[#FAF8F5] relative overflow-hidden">
  <!-- Background accent -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-linear-to-r from-transparent via-primary to-transparent opacity-20" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-16">
      <span class="text-primary font-semibold tracking-wider text-sm uppercase mb-3 block">Entre em Contato</span>
      <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl font-bold text-foreground leading-tight mb-4">
        VISITE NOSSA <span class="text-primary">ESCOLA</span>
      </h2>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto leading-relaxed font-light">
        Seu filho merece mais do que você pode ver em um site. Venha conhecer de perto o Colégio Sagrado
        e sentir a segurança, o cuidado e a excelência do nosso trabalho.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">

      <!-- Form card — 3 cols -->
      <div class="lg:col-span-3 bg-white rounded-2xl shadow-xl p-8 md:p-10 border border-gray-100">
        <h3 class="font-['Playfair_Display'] text-2xl font-bold text-foreground mb-8">
          Agende uma visita
        </h3>

        <form
          aria-label="Formulário de agendamento de visita"
          class="space-y-5"
          novalidate
        >
          <!-- Name + Phone row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="cf-name" class="block text-sm font-semibold text-gray-700 mb-1.5">
                Nome completo <span class="text-primary" aria-hidden="true">*</span>
              </label>
              <input
                id="cf-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Seu nome"
                class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
              />
            </div>
            <div>
              <label for="cf-phone" class="block text-sm font-semibold text-gray-700 mb-1.5">
                Telefone / WhatsApp <span class="text-primary" aria-hidden="true">*</span>
              </label>
              <input
                id="cf-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="(11) 9 0000-0000"
                class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
              />
            </div>
          </div>

          <!-- Email -->
          <div>
            <label for="cf-email" class="block text-sm font-semibold text-gray-700 mb-1.5">
              E-mail
            </label>
            <input
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="seuemail@exemplo.com"
              class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
            />
          </div>

          <!-- Segment select -->
          <div>
            <label for="cf-segment" class="block text-sm font-semibold text-gray-700 mb-1.5">
              Segmento de interesse <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <select
              id="cf-segment"
              name="segment"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors bg-white appearance-none"
            >
              <option value="" disabled selected>Selecione um segmento</option>
              {segments.map((seg) => (
                <option value={seg}>{seg}</option>
              ))}
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="cf-message" class="block text-sm font-semibold text-gray-700 mb-1.5">
              Mensagem (opcional)
            </label>
            <textarea
              id="cf-message"
              name="message"
              rows="4"
              placeholder="Diga o que quiser saber sobre o colégio..."
              class="w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 placeholder-gray-400 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-4 px-8 rounded-lg shadow-lg shadow-primary/25 transition-all hover:scale-[1.02] tracking-wider uppercase text-sm cursor-pointer"
          >
            Enviar Mensagem
          </button>

          <p class="text-xs text-gray-400 text-center">
            Ao enviar, você concorda com nossa{' '}
            <a href="#" class="underline hover:text-primary transition-colors cursor-pointer">Política de Privacidade</a>.
          </p>
        </form>
      </div>

      <!-- Info + mascote column — 2 cols -->
      <div class="lg:col-span-2 flex flex-col gap-8">

        <!-- Contact info card -->
        <div class="bg-primary rounded-2xl p-8 text-white">
          <h3 class="font-['Playfair_Display'] text-xl font-bold mb-6">Informações de Contato</h3>
          <ul class="space-y-5" role="list">
            {contactItems.map((item) => (
              <li class="flex items-start gap-4">
                <span class="mt-0.5 w-9 h-9 rounded-full bg-white/15 flex items-center justify-center shrink-0 text-secondary">
                  <Fragment set:html={item.icon} />
                </span>
                <div>
                  <p class="text-white/60 text-xs uppercase tracking-wider font-semibold mb-0.5">{item.label}</p>
                  <p class="text-white font-medium text-sm">{item.value}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Mascote card -->
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6 text-center overflow-hidden relative">
          <div class="absolute top-0 left-0 right-0 h-1 bg-secondary" aria-hidden="true"></div>

          <p class="font-['Playfair_Display'] text-lg font-bold text-foreground mb-1">
            A gente quer te conhecer!
          </p>
          <p class="text-gray-500 text-sm mb-4 leading-relaxed">
            Venha visitar o Colégio Sagrado e sentir a diferença.
          </p>

          <img
            src={mascote.src}
            alt="Mascote do Colégio Sagrado Coração de Jesus"
            loading="lazy"
            width="200"
            height="200"
            class="w-36 h-36 object-cover rounded-full mx-auto mb-4 shadow-md border-4 border-secondary/40"
          />

          <a
            href="https://wa.me/55987031316"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold px-6 py-3 rounded-full text-sm transition-all hover:scale-105 shadow-md cursor-pointer"
          >
            <!-- WhatsApp icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.118 1.527 5.845L.057 23.882a.5.5 0 0 0 .611.611l6.037-1.47A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.797 9.797 0 0 1-5.007-1.375l-.36-.214-3.713.904.92-3.614-.235-.372A9.803 9.803 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
            </svg>
            Falar pelo WhatsApp
          </a>
        </div>

      </div>
    </div>
  </div>
</section>
