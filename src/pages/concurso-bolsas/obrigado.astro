---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <script is:inline>
    (function () {
      var meta = document.createElement('meta');
      meta.setAttribute('name', 'robots');
      meta.setAttribute('content', 'noindex, nofollow');
      document.head.appendChild(meta);
    })();
  </script>

  <main
    id="main-content"
    class="min-h-screen flex items-center justify-center bg-[#FAF8F5] px-4 py-24"
  >
    <div class="max-w-2xl text-center">
      <span
        class="text-primary font-semibold tracking-wider text-sm uppercase mb-3 block"
        data-cb-status="neutral"
        >Concurso de Bolsas</span
      >
      <h1
        class="font-serif text-4xl md:text-5xl font-bold text-foreground leading-tight mb-4"
      >
        <span data-cb-heading="submitted" hidden>Manifestação <span class="text-primary">recebida</span></span>
        <span data-cb-heading="neutral">Sua visita ao <span class="text-primary">Concurso de Bolsas</span></span>
      </h1>
      <p
        class="text-gray-600 text-lg leading-relaxed font-light mb-8"
        data-cb-body="submitted"
        hidden
      >
        Sua manifestação de interesse foi encaminhada à escola. Caso os dados
        estejam corretos, a equipe entrará em contato em breve pelo WhatsApp
        ou telefone informados para explicar as condições do concurso e os
        próximos passos.
      </p>
      <p
        class="text-gray-600 text-lg leading-relaxed font-light mb-8"
        data-cb-body="neutral"
      >
        Esta página confirma o encerramento do envio. Se você acabou de enviar a
        manifestação, aguarde o contato da escola. A confirmação não garante
        bolsa, matrícula ou aprovação — apenas registra o seu interesse.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/concurso-bolsas/"
          class="inline-flex items-center justify-center bg-primary hover:bg-primary-dark text-white font-bold py-3 px-6 rounded-full shadow-lg shadow-primary/25 transition-all hover:scale-[1.02] tracking-wider uppercase text-sm"
        >
          Enviar outra manifestação
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center bg-white border border-gray-200 text-gray-700 hover:border-primary hover:text-primary font-bold py-3 px-6 rounded-full transition-all tracking-wider uppercase text-sm"
        >
          Voltar à página inicial
        </a>
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var submitted = params.get('submitted') === '1';

      function toggleGroup(attribute, value) {
        document.querySelectorAll('[data-cb-' + attribute + ']').forEach(function (el) {
          var match = el.getAttribute('data-cb-' + attribute) === value;
          if (match) {
            el.removeAttribute('hidden');
          } else {
            el.setAttribute('hidden', '');
          }
        });
      }

      if (submitted) {
        toggleGroup('heading', 'submitted');
        toggleGroup('body', 'submitted');
        toggleGroup('status', 'submitted');
      } else {
        toggleGroup('heading', 'neutral');
        toggleGroup('body', 'neutral');
        toggleGroup('status', 'neutral');
      }
    })();
  </script>
</Layout>
