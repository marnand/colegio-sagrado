---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.tsx';
import ConcursoBolsasForm from '../components/ConcursoBolsasForm.astro';
import Footer from '../components/Footer.astro';

// TODO: substituir antes da publicação — definir com a escola.
const copy = {
  eyebrow: 'Concurso de Bolsas',
  title: 'Demonstre interesse no',
  highlighted: 'Concurso de Bolsas',
  description:
    'Preencha o formulário para que a escola entre em contato, apresente as condições do concurso e oriente sua família sobre os próximos passos.',
  ctaPrimary: 'Manifestação de interesse',
  ctaSecondary: 'Enviar manifestação',
};

// TODO: substituir pela imagem aprovada pela escola antes da publicação.
const heroImage = {
  src: '/turma.webp',
  alt: 'Alunos do Colégio Sagrado em sala de aula durante atividade pedagógica',
};

// TODO: definir com a escola as turmas e turnos que aparecerão no formulário.
const gradeOptions = [
  { value: 'educacao-infantil', label: 'Educação Infantil' },
  { value: 'fundamental-i', label: 'Ensino Fundamental I' },
  { value: 'fundamental-ii', label: 'Ensino Fundamental II' },
];

const shiftOptions = [
  { value: 'matutino', label: 'Matutino' },
  { value: 'vespertino', label: 'Vespertino' },
];

// TODO: confirmar com a escola os limites mínimo e máximo de idade.
const ageMin = 2;
const ageMax = 14;

// TODO: substituir pela URL da política aprovada pela escola antes da publicação.
const privacyUrl = '/privacidade/';
const privacyLabel = 'Política de Privacidade';

// TODO: confirmar com a escola a página canônica e a chave Web3Forms própria da campanha.
const campaignSubject = 'Concurso de Bolsas — manifestação de interesse';
const campaignFromName = 'Concurso de Bolsas — Colégio Sagrado';
const campaignAccessKey = import.meta.env.PUBLIC_WEB3FORMS_CONCURSO_ACCESS_KEY ?? '';
const campaignEnabledRaw = import.meta.env.PUBLIC_CONCURSO_BOLSAS_FORM_ENABLED ?? 'false';
const campaignEnabled = campaignEnabledRaw === 'true' || campaignEnabledRaw === '1';
const campaignRedirect = 'https://colegiosagrado.com.br/concurso-bolsas/obrigado/?submitted=1';
const campaignAction = 'https://api.web3forms.com/submit';
const campaignScriptSrc = 'https://web3forms.com/client/script.js';

const pageTitle = 'Concurso de Bolsas — Colégio Sagrado';
const pageDescription =
  'Manifeste interesse no concurso de bolsas do Colégio Sagrado do Coração de Jesus e aguarde o contato da escola.';
---

<Layout>
  <Header client:load variant="standalone" />

  <main
    id="main-content"
    class="min-h-screen overflow-x-hidden bg-white"
  >
    <section
      class="relative pt-32 pb-16 bg-surface-dark overflow-hidden"
    >
      <div class="absolute inset-0 z-0 opacity-40">
        <img
          src={heroImage.src}
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover grayscale"
          loading="eager"
        />
        <div class="absolute inset-0 bg-linear-to-t from-surface-dark via-primary/80 to-surface-dark/90"></div>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
        <span class="inline-block py-1 px-3 bg-secondary/20 text-secondary border border-secondary/30 rounded-full text-sm font-semibold uppercase tracking-widest mb-6">
          {copy.eyebrow}
        </span>
        <h1 class="font-serif text-4xl md:text-6xl font-bold text-white mb-6 leading-tight">
          {copy.title} <span class="text-secondary">{copy.highlighted}</span>
        </h1>
        <p class="text-xl text-white/80 mb-2 max-w-2xl mx-auto font-light">
          {copy.description}
        </p>
        <p class="text-base text-white/60 max-w-2xl mx-auto font-light">
          O envio é uma manifestação de interesse. As condições e prazos do
          concurso serão informados pela escola após o contato inicial.
        </p>
      </div>
    </section>

    <ConcursoBolsasForm
      copy={copy}
      heroImage={heroImage}
      gradeOptions={gradeOptions}
      shiftOptions={shiftOptions}
      ageMin={ageMin}
      ageMax={ageMax}
      privacyUrl={privacyUrl}
      privacyLabel={privacyLabel}
      campaignSubject={campaignSubject}
      campaignFromName={campaignFromName}
      campaignAccessKey={campaignAccessKey}
      campaignEnabled={campaignEnabled}
      campaignRedirect={campaignRedirect}
      campaignAction={campaignAction}
      campaignScriptSrc={campaignScriptSrc}
    />
  </main>

  <Footer />

  <script is:inline>
    (function () {
      var form = document.getElementById('formulario');
      if (!form) return;
      var submitBtn = form.querySelector('#form-submit');
      var status = form.querySelector('#form-status');
      var originalLabel = submitBtn ? submitBtn.textContent : 'Enviar';
      var submitting = false;

      function setStatus(message, kind) {
        if (!status) return;
        status.textContent = message;
        status.classList.remove(
          'hidden',
          'bg-green-100',
          'text-green-800',
          'bg-red-100',
          'text-red-800'
        );
        if (kind === 'success') {
          status.classList.add('bg-green-100', 'text-green-800');
        } else {
          status.classList.add('bg-red-100', 'text-red-800');
        }
      }

      function clearStatus() {
        if (!status) return;
        status.textContent = '';
        status.classList.add('hidden');
        status.classList.remove(
          'bg-green-100',
          'text-green-800',
          'bg-red-100',
          'text-red-800'
        );
      }

      function setSubmitting(value) {
        if (!submitBtn) return;
        submitting = value;
        submitBtn.disabled = value;
        submitBtn.textContent = value ? 'Enviando...' : originalLabel;
      }

      window.addEventListener('pageshow', function () {
        setSubmitting(false);
        clearStatus();
      });

      form.addEventListener('submit', function () {
        if (submitting) return;
        clearStatus();
        var captcha = form.querySelector('textarea[name="h-captcha-response"]');
        if (captcha && !captcha.value) {
          setStatus('Por favor, complete o desafio de segurança.', 'error');
          return;
        }
        setSubmitting(true);
      });
    })();
  </script>
</Layout>
