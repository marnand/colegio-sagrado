---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.tsx';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import MissionValues from '../components/MissionValues.astro';
import DirectorMessage from '../components/DirectorMessage.astro';
import WhyUs from '../components/WhyUs.astro';
import SmallClasses from '../components/SmallClasses.astro';
import QuickLinks from '../components/QuickLinks.astro';
import Marquee from '../components/Marquee.astro';
import AcademicJourney from '../components/AcademicJourney.tsx';
import Calendar from '../components/Calendar.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <div class="min-h-screen overflow-x-hidden">
    <Header client:load />
    <Hero />
    <About />
    <MissionValues />
    <DirectorMessage />
    <WhyUs />
    <SmallClasses />
    <QuickLinks />
    <Marquee />
    <AcademicJourney client:load />
    <Calendar />
    <Testimonials />
    <CTA />
    <ContactForm />
    <Footer />
  </div>
</Layout>
